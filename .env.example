# Copy to .env and fill in. NEVER commit the filled-in file.
# Names only are documented here; no real values belong in the repository.

# --- Primary interpreter: Google Gemini (free tier) ---------------------------
# One key, or several comma-separated keys. Extra keys are rotated
# automatically when one hits its rate limit.
GEMINI_API_KEYS=

# Comma-separated model preference list; the first that answers wins.
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-latest

# --- Optional secondary interpreter: any OpenAI-compatible endpoint ----------
# Used only if every Gemini key fails. Groq's free tier is the default target.
OPENAI_COMPAT_API_KEYS=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# --- Tuning ------------------------------------------------------------------
# Per-attempt model timeout in seconds. Kept well below the judge's 30s limit.
LLM_TIMEOUT_SECONDS=12

# Port the service binds to (the container binds 0.0.0.0 on this port).
PORT=8000
