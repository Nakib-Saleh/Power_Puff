# Copy to .env and fill in. NEVER commit the filled-in file.
# Names only are documented here; no real values belong in the repository.

# --- Fallback interpreter: Google Gemini (free tier) --------------------------
# Used when every Groq model is rate-limited or unreachable.
# One key, or several comma-separated keys, rotated on quota errors.
GEMINI_API_KEYS=

# Comma-separated model cascade; the first that answers wins.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-flash-latest

# --- Primary interpreter: any OpenAI-compatible endpoint (Groq by default) ---
# Keys from DIFFERENT accounts add real capacity; Groq meters per organisation
# and per model, so the key list and model list multiply into separate buckets.
OPENAI_COMPAT_API_KEYS=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# --- Tuning ------------------------------------------------------------------
# Per-attempt model timeout in seconds. Kept well below the judge's 30s limit.
LLM_TIMEOUT_SECONDS=12

# Port the service binds to (always on 0.0.0.0). Leave UNSET on hosts that
# inject their own PORT, such as Render -- hardcoding it breaks their routing.
PORT=8000
